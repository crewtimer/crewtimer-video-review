{
  "name": "crewtimer-video-review",
  "description": "Review finish line video and post timing data to CrewTimer",
  "engines": {
    "node": ">=22.12.0"
  },
  "resolutions": {
    "@protobufjs/utf8": "1.1.2",
    "browserslist": "4.28.7",
    "electron-to-chromium": "1.5.401",
    "protobufjs": "7.6.3",
    "websocket-driver": "0.7.5"
  },
  "keywords": [
    "electron",
    "boilerplate",
    "react",
    "typescript",
    "ts",
    "sass",
    "webpack",
    "hot",
    "reload"
  ],
  "homepage": "https://github.com/crewtimer/crewtimer-video-review/#readme",
  "bugs": {
    "url": "https://github.com/crewtimer/crewtimer-video-review/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crewtimer/crewtimer-video-review.git"
  },
  "license": "MIT",
  "author": {
    "name": "Glenn Engel",
    "email": "glenne@crewtimer.com",
    "url": "https://www.linkedin.com/in/glenn-engel-610a3625/"
  },
  "contributors": [],
  "main": "./.erb/dll/main.bundle.dev.js",
  "scripts": {
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:dll": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.dev.dll.ts",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "postinstall": "patch-package && ts-node .erb/scripts/check-native-dep.js && electron-builder install-app-deps && npm run build:dll",
    "lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "package": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build --publish never && npm run build:dll",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "rebuild:win-sqlite": "electron-rebuild --force --only sqlite3 --module-dir release/app --arch x64 --platform win32",
    "prestart": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.dev.ts",
    "start": "ts-node ./.erb/scripts/check-port-in-use.js && npm run prestart && npm run start:renderer",
    "start:main": "concurrently -k \"cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --watch --config ./.erb/configs/webpack.config.main.dev.ts\" \"electronmon .\"",
    "start:preload": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.preload.dev.ts",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "test": "jest",
    "test:ui": "npm run build && playwright test --config=playwright.electron.config.ts",
    "build:win": "npm run rebuild:win-sqlite && node .erb/scripts/stage-win-native.js && npm run build && node_modules/.bin/electron-builder --win -c.npmRebuild=false && node .erb/scripts/verify-win-package.js",
    "build:mac": "npm run build && APPLE_KEYCHAIN_PROFILE=crewtimer-app-signing node_modules/.bin/electron-builder --mac",
    "build:macx64": "npm run build && node_modules/.bin/electron-builder --mac --arch x64",
    "build:macarm64": "npm run build && node_modules/.bin/electron-builder --mac --arch arm64",
    "kill": "kill -9 `lsof -i:1212 -t`",
    "build:native": "cd release/app && yarn add ../../native/ffreader && cd node_modules/crewtimer_video_reader && yarn rebuild",
    "build:release": "yarn clean && yarn build && yarn build:mac && yarn build:win && open release/build",
    "cleanbasic": "ts-node ./.erb/scripts/clean.js && rm -rf release/build",
    "clean": "rm -rf .erb/node_modules .erb/dll node_modules src/node_modules release/build release/app/node_modules native/ffreader/prebuilds native/ffreader/build && yarn install"
  },
  "browserslist": [
    "extends browserslist-config-erb"
  ],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|svg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "setupFiles": [
      "./.erb/scripts/check-build-exists.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "release/app/dist",
      ".erb/dll"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    }
  },
  "dependencies": {
    "@electron/notarize": "^3.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/lab": "^9.0.0-beta.6",
    "@mui/material": "^9.2.0",
    "@mui/styles": "^6.4.8",
    "axios": "^1.19.0",
    "clsx": "^2.0.0",
    "crewtimer-common": "^1.0.25",
    "electron-debug": "^4.1.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "fast-deep-equal": "^3.1.3",
    "firebase": "^12.17.0",
    "github-markdown-css": "^5.9.0",
    "history": "^5.3.0",
    "jszip": "^3.10.1",
    "moment-timezone": "^0.5.48",
    "path-browserify": "^1.0.1",
    "react": "^19.2.0",
    "react-data-grid": "^7.0.0-beta.61",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.1",
    "react-markdown-css": "^1.0.2",
    "react-measure": "^2.5.2",
    "react-router-dom": "^6.30.4",
    "react-usedatum": "^1.0.7",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-virtuoso": "^4.18.11",
    "react-window": "^1.8.11",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "short-uuid": "^4.2.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@svgr/webpack": "^8.1.0",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.5",
    "@types/node": "20.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-measure": "^2.0.12",
    "@types/react-test-renderer": "^19.1.0",
    "@types/react-window": "^1.8.5",
    "@types/sqlite3": "^3.1.11",
    "@types/terser-webpack-plugin": "^5.0.4",
    "@types/webpack-bundle-analyzer": "^4.6.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "browserslist": "^4.28.7",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^8.2.1",
    "core-js": "^3.49.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^1.5.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-to-chromium": "^1.5.401",
    "electronmon": "^2.0.4",
    "eslint": "^8.49.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-erb": "^4.1.0-0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-import-resolver-webpack": "^0.13.11",
    "eslint-plugin-compat": "^4.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^27.4.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.10.2",
    "patch-package": "^8.0.0",
    "prettier": "^3.9.6",
    "raw-loader": "^4.0.2",
    "react-refresh": "^0.14.0",
    "react-test-renderer": "^19.2.0",
    "rimraf": "^5.0.1",
    "sass": "^1.102.0",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.9.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.109.2",
    "webpack-bundle-analyzer": "^4.9.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.9.0"
  },
  "build": {
    "productName": "CrewTimer Video Review",
    "appId": "net.entazza.CrewTimerVideoReview",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll,dylib}",
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/**/*.tsbuildinfo",
      "package.json",
      "!node_modules/**/*",
      "node_modules/sqlite3/package.json",
      "node_modules/sqlite3/lib/**/*",
      "node_modules/sqlite3/build/Release/*.node",
      "node_modules/crewtimer_video_reader/package.json",
      "node_modules/crewtimer_video_reader/index.js",
      "node_modules/crewtimer_video_reader/build/Release/*.{node,dll,dylib}",
      "node_modules/bindings/package.json",
      "node_modules/bindings/bindings.js",
      "node_modules/file-uri-to-path/package.json",
      "node_modules/file-uri-to-path/index.js"
    ],
    "mac": {
      "notarize": true,
      "target": {
        "target": "default",
        "arch": [
          "arm64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "CrewTimer Video Review sends timing and control messages to CrewTimer Video Recorder.",
        "NSBonjourServices": [
          "_crewtimer._udp"
        ]
      },
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      },
      {
        "from": "native/bowdetect/bow_crnn.onnx",
        "to": "bow_crnn.onnx"
      },
      {
        "from": "native/bowdetect/bow_card_detect.onnx",
        "to": "bow_card_detect.onnx"
      },
      {
        "from": "native/bowdetect/crewtimer-boat-train.onnx",
        "to": "crewtimer-boat-train.onnx"
      },
      {
        "from": "native/rife/rife_v4.6.onnx",
        "to": "rife_v4.6.onnx"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "crewtimer",
      "repo": "crewtimer-recorder"
    }
  },
  "collective": {
    "url": "https://opencollective.com/electron-react-boilerplate-594"
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "src/main/**",
      ".erb/dll/**"
    ],
    "logLevel": "quiet"
  },
  "opencv4nodejs": {}
}
