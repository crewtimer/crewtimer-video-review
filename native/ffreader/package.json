{
  "name": "crewtimer_video_reader",
  "version": "1.0.28-ffreader",
  "description": "A node electron utility to read mp4 files for CrewTimer Video Review",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "install": "prebuild-install --verbose -r napi || yarn rebuild",
    "install-prebuild": "prebuild-install --verbose -r napi",
    "prebuild": "node node_modules/prebuild/bin.js --runtime napi --all --verbose",
    "build:mac-arm": "node node_modules/prebuild/bin.js --napi --napi-version 6 --runtime napi --arch arm64 --platform darwin",
    "build:mac": "yarn build:mac-arm",
    "build:win": "node node_modules/node-gyp/bin/node-gyp.js rebuild --arch=x64 --target_platform=win32",
    "build:win:local": "node node_modules/prebuild/bin.js --napi --napi-version 6 --runtime napi --arch=x64 --platform win32 --no-upload --no-upload-all",
    "build:opencv": "bash ./scripts/build-opencv.sh",
    "build:ffmpeg": "bash ./scripts/build-ffmpeg.sh",
    "build:onnxruntime": "bash ./scripts/build-onnxruntime.sh",
    "rebuild": "node-gyp rebuild",
    "uploadall": "node node_modules/prebuild/bin.js --upload-all $GITHUB_TOKEN",
    "upload": "node node_modules/prebuild/bin.js --verbose --runtime napi",
    "build": "node node_modules/node-gyp/bin/node-gyp.js rebuild",
    "clean": "rm -rf node_modules yarn.lock prebuilds build"
  },
  "keywords": [],
  "author": "Glenn Engel (glenne)",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.9.1",
    "node-addon-api": "^8.2.2",
    "node-gyp": "^10.2.0",
    "prebuild": "^13.0.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "prebuild-install": "^7.1.2",
    "tar": "^7.4.3"
  },
  "binary": {
    "napi_versions": [
      6
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/crewtimer/crewtimer-video-review.git"
  }
}
