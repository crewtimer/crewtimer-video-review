{
  "model": "bow_crnn.onnx",
  "architecture": "CTC CRNN (whole bow-number sequence, 1-3 digits)",
  "classes": "-0123456789",
  "blankIndex": 0,
  "input": {
    "height": 48,
    "width": "60px (fixed physical bow-card geometry)"
  },
  "decode": "greedy CTC: argmax per timestep, collapse consecutive repeats, drop blank",
  "datasets": [
    "/Users/glenne/training/datasets/dataset-ACAT25",
    "/Users/glenne/training/datasets/dataset-1",
    "/Users/glenne/training/datasets/dataset-acanat26",
    "/Users/glenne/training/datasets/dataset-hocr26"
  ],
  "extraction": {
    "script": "extract_card_training_crops.py",
    "note": "whole-card crops labelled with the full digit string (no per-glyph segmentation)",
    "validationPercent": 20,
    "trainingCards": 528,
    "validationCards": 117,
    "cropSource": "production bow-card detector (633/634), annotation fallback (1/634)"
  },
  "additionalTrainingCrops": 11,
  "training": {
    "epochs": 30,
    "syntheticSamplesPerEpoch": 5000,
    "batchSize": 128,
    "syntheticRange": "integers 1-199, weighted 40%/50%/10% by digit length",
    "checkpointMetric": "held-out real full-string accuracy"
  },
  "validation": {
    "syntheticMixedLengthAccuracy": 1.0,
    "heldOutRealFullStringAccuracy": "107/117 (91.5%)",
    "heldOutTwoDigitAccuracy": "52/55 (94.5%)",
    "heldOutHOCRAccuracy": "58/62 (93.5%)",
    "endToEndKayakRegressions": "6/6"
  }
}
